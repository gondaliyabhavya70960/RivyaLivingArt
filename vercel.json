{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "functions": {
    "app/api/cron/research/route.ts": { "maxDuration": 300, "memory": 1024 },
    "app/api/cron/research-analytics/route.ts": { "maxDuration": 300, "memory": 1024 },
    "app/api/cron/research-score/route.ts": { "maxDuration": 300, "memory": 1024 },
    "app/api/cron/sheets-sync/route.ts": { "maxDuration": 300 },
    "app/api/cron/analytics-snapshot/route.ts": { "maxDuration": 300 },
    "app/api/cron/log-retention/route.ts": { "maxDuration": 300 },
    "app/api/media/sign/route.ts": { "memory": 1024 },
    "app/(studio)/studio/(shell)/media/actions.ts": { "maxDuration": 120, "memory": 1024 }
  },
  "crons": [
    { "path": "/api/cron/content-schedule", "schedule": "0 3 * * *" },
    { "path": "/api/cron/research", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/research-analytics", "schedule": "30 2 * * *" },
    { "path": "/api/cron/research-score", "schedule": "15 3 * * *" },
    { "path": "/api/cron/sheets-sync", "schedule": "0 * * * *" },
    { "path": "/api/cron/analytics-snapshot", "schedule": "45 3 * * *" },
    { "path": "/api/cron/log-retention", "schedule": "15 4 * * *" }
  ]
}
