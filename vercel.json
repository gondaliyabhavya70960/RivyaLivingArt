{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/content-schedule",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/research-analytics",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/research-score",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/sheets-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/analytics-snapshot",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/log-retention",
      "schedule": "15 4 * * *"
    }
  ]
}
