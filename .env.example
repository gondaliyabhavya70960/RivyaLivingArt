# Committed. NAMES ONLY — never a value, not even a truncated one.
# Copy to .env.local and fill in from the Supabase and Cloudinary dashboards.
# See docs/ops/ENVIRONMENT.md for what each one is for and what breaks without it.

# ---- public ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- server only ----
# Bypasses RLS. Server code only; never imported by a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct (5432) connection, not the pooled 6543 endpoint: migrations need session state
# that pgbouncer's transaction mode cannot hold.
DATABASE_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Phase 36 (Google Sheets, one-way export). The service-account JSON as ONE line, and the id from
# the spreadsheet's URL. Share the spreadsheet with the JSON's client_email; the integration asks
# for the spreadsheets scope only. Setup steps: docs/ops/ENVIRONMENT.md §4. Optional: absent, the
# Sheets page says NOT_CONFIGURED and nothing else degrades.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Read by the research fetcher from Phase 25 on, and it has NO fallback: a missing one throws.
# Not a secret — its whole job is to identify Rivya to the sites it reads and give them a way to
# reach us. Shape: Rivya-Research/1.0 (+https://<your-domain>/contact)
SCRAPER_USER_AGENT=
REVALIDATE_SECRET=
# The bearer token Vercel Cron sends with a scheduled invocation. THE NAME IS FIXED: Vercel
# attaches `Authorization: Bearer <value>` only for a variable named exactly CRON_SECRET, so
# renaming it makes the header silently absent and every tick 401s with nothing logged anywhere.
CRON_SECRET=

# ---------------------------------------------------------------------------------------------
# Phase 40 — Core Web Vitals field data
# ---------------------------------------------------------------------------------------------
# NEXT_PUBLIC_VERCEL_ENV is INJECTED BY VERCEL and is listed here only so its role is documented;
# do not set it by hand. `components/patterns/VitalsReporter` reports only when it reads exactly
# `production`, because `web_vitals_samples` has no environment column — deliberately, since one
# more column is one more thing to segment visitors by — and a preview deployment's numbers would
# otherwise mix silently into the p75 the team reads as "the site". Locally it is unset, so the
# reporter is inert and no beacon is ever sent from a developer's machine.
#
# Vercel exposes VERCEL_ENV to the server automatically. The NEXT_PUBLIC_ copy has to be added in
# the dashboard for each environment (Production = production, Preview = preview) because only a
# NEXT_PUBLIC_ variable is readable in a Client Component. WITHOUT IT NOTHING BREAKS: the reporter
# simply never reports, and the Studio panel stays empty with its "no samples yet" state.
NEXT_PUBLIC_VERCEL_ENV=

# ---------------------------------------------------------------------------------------------
# Phase 41 — security
# ---------------------------------------------------------------------------------------------
# The key for `hmac(salt, ip)` on `inquiries.ip_hash`. A SECRET, and the reason is arithmetic:
# there are four billion IPv4 addresses, so an unsalted digest of an address is the address to
# anybody with a laptop. With this set, a stored ip_hash is meaningless without it.
#
# WITHOUT IT NOTHING BREAKS AND THAT IS THE DANGER. `salt()` falls back to RATE_LIMIT_SALT, then
# to SUPABASE_SERVICE_ROLE_KEY, then to the literal string "rivya" — a chain that exists so a
# rename does not reset every live rate-limit window on deploy, and whose last rung is public.
# Set it. /studio/system/environment shows whether it is set, and never its value.
#
# ROTATING IT IS A DECISION, NOT MAINTENANCE: every existing ip_hash stops matching, so a
# returning enquirer is no longer recognisable as one. Generate with `openssl rand -base64 32`.
IP_HASH_SALT=
# The key for rate-limit bucket keys. Separate from IP_HASH_SALT because rotating THIS one costs
# nothing but a cleared window, and two salts with different lifetimes must not share a value.
RATE_LIMIT_SALT=
# `1` enforces the content security policy; anything else (including unset) ships it as
# Content-Security-Policy-Report-Only with violations posted to /api/csp-report and logged at
# SECURITY level. THE DEFAULT IS REPORT-ONLY AND THAT IS DELIBERATE: a policy that breaks the 3D
# viewer breaks it in production, on somebody's device, and the first report is usually a person
# saying the page is blank. Soak first — read /studio/operations/logs filtered to SECURITY — then
# set this to 1 and redeploy. Forgetting it costs enforcement, not availability.
CSP_ENFORCE=

# ---------------------------------------------------------------------------------------------
# Post-launch (amendment A43) — the first Studio account, from the environment
# ROADMAP.md: "there is no Phase 47". This is post-launch work, and is labelled as such.
# ---------------------------------------------------------------------------------------------
# `npm run auth:bootstrap` reads these four and creates the ONE account the Studio cannot create
# for itself: the first owner. Every other account is invited from /studio/system/users, where the
# act is permission-checked and audited. Unset, the script does nothing and exits 0 — a deployment
# that made its owner another way has not misconfigured anything.
#
# THE SCRIPT NEVER CHANGES AN EXISTING ACCOUNT'S PASSWORD unless it is given --reset-password, so
# wiring it into a deploy does not silently undo a password change on the next deploy.
STUDIO_ADMIN_EMAIL=
# A SECRET. Never passed as a command-line argument — argv is in the shell history and in the
# process table — and never printed, measured or logged. Generate with `openssl rand -base64 24`.
STUDIO_ADMIN_PASSWORD=
# Optional. owner · admin · editor · merchandiser · researcher · viewer. DEFAULTS TO owner, which
# is the point of the bootstrap: an admin can be invited the moment any owner can sign in, and
# `system.owner.transfer` is the one permission no role but owner holds.
STUDIO_ADMIN_ROLE=
# Optional display name for that account.
STUDIO_ADMIN_NAME=
