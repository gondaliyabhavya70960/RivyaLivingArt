# Committed. NAMES ONLY — never a value, not even a truncated one.
# Copy to .env.local and fill in from the Supabase and Cloudinary dashboards.
# See docs/ops/ENVIRONMENT.md for what each one is for and what breaks without it.

# ---- public ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- server only ----
# Bypasses RLS. Server code only; never imported by a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct (5432) connection, not the pooled 6543 endpoint: migrations need session state
# that pgbouncer's transaction mode cannot hold.
DATABASE_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
SCRAPER_USER_AGENT=
REVALIDATE_SECRET=
# The bearer token Vercel Cron sends with a scheduled invocation. THE NAME IS FIXED: Vercel
# attaches `Authorization: Bearer <value>` only for a variable named exactly CRON_SECRET, so
# renaming it makes the header silently absent and every tick 401s with nothing logged anywhere.
CRON_SECRET=
