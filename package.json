{
  "name": "rivya-living-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manifest:build": "python3 scripts/media/build-higgsfield-manifest.py",
    "manifest:verify": "npm run manifest:build && git diff --exit-code data/higgsfield/asset-manifest.json",
    "media:check-ids": "python3 scripts/media/check-asset-ids.py",
    "design:check-tokens": "node scripts/design/check-tokens.mjs",
    "design:check-registry": "node scripts/design/check-registry.mjs",
    "design:check-utilities": "node scripts/design/check-utilities.mjs",
    "db:reset": "node scripts/db/reset.mjs",
    "db:types": "node scripts/db/gen-types.mjs",
    "db:check-types": "node scripts/db/check-types.mjs",
    "db:check-data-layer": "node scripts/db/check-data-layer.mjs",
    "db:check-migrations": "node scripts/db/check-migrations.mjs",
    "seed:content": "tsx scripts/seed/seed-content.ts",
    "db:check-schema": "node scripts/db/check-schema.mjs",
    "db:check-hosted-layout": "node scripts/db/check-hosted-layout.mjs",
    "auth:gen-policies": "tsx scripts/auth/gen-role-sql.ts",
    "auth:check-policies": "tsx scripts/auth/gen-role-sql.ts --check",
    "auth:check-rls": "tsx scripts/auth/check-rls.ts",
    "security:check-bundle": "node scripts/security/check-bundle-secrets.mjs",
    "security:check-proxy": "node scripts/security/check-proxy.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "media:check-folders": "node scripts/media/check-folders.mjs",
    "media:check-provider": "node scripts/media/check-provider-boundary.mjs",
    "perf:check-image-props": "node scripts/perf/check-image-props.mjs",
    "perf:check-video-props": "node scripts/perf/check-video-props.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "cloudinary": "^2.11.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
